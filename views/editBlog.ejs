<!DOCTYPE html>
<html>
<head>
  <title>Edit Blog - <%= blog.title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f0fdf4;
      margin: 0;
      padding: 0;
    }

    .top-bar {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      background-color: #d1fae5;
      padding: 1rem 2rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .top-bar img {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 10px;
    }

    .top-bar a {
      padding: 0.5rem 1rem;
      background-color: #f44336;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }

    .top-bar a:hover {
      background-color: #d32f2f;
    }

    .container {
      max-width: 800px;
      margin: 3rem auto;
      background: #fff;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }

    form label {
      display: block;
      margin-top: 1rem;
      font-weight: bold;
      color: #333;
    }

    form input[type="text"],
    form textarea {
      width: 100%;
      padding: 0.7rem;
      margin-top: 0.5rem;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 1rem;
    }

    form button {
      margin-top: 1.5rem;
      padding: 0.7rem 1.5rem;
      background-color: #2e7d32;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      cursor: pointer;
      font-weight: bold;
    }

    form button:hover {
      background-color: #256029;
    }

    .back-link {
      display: inline-block;
      margin-top: 2rem;
      color: #2e7d32;
      text-decoration: none;
      font-weight: bold;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <img src="<%= user.profileImage %>" alt="Profile Image"/>
    <a href="/logout">Logout</a>
  </div>

  <div class="container">
    <h1>Edit Blog</h1>
    <form action="/blog/update/<%= blog._id %>" method="POST">
      <label for="title">Blog Title:</label>
      <input type="text" id="title" name="title" value="<%= blog.title %>" required>

      <label for="image">Blog Image URL:</label>
      <input type="text" id="image" name="image" value="<%= blog.image %>" required>

      <label for="description">Description:</label>
      <textarea id="description" name="description" rows="6" required><%= blog.description %></textarea>

      <button type="submit">Update Blog</button>
    </form>

    <a class="back-link" href="/dashboard">← Back to Dashboard</a>
  </div>
</body>
</html>
