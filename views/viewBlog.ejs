<!DOCTYPE html>
<html>
<head>
  <title><%= blog.title %> - View Blog</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f0fdf4;
      margin: 0;
      padding: 0;
    }

    .top-bar {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding: 1rem 2rem;
      background-color: #d1fae5;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .top-bar img {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 10px;
    }

    .top-bar a {
      padding: 0.5rem 1rem;
      background-color: #f44336;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }

    .top-bar a:hover {
      background-color: #d32f2f;
    }

    .container {
      max-width: 800px;
      margin: 3rem auto;
      background: white;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }

    .container img {
      width: 100%;
      max-width: 600px;
      border-radius: 8px;
      margin: 1rem 0;
    }

    h1 {
      margin-bottom: 1rem;
      color: #333;
    }

    p {
      font-size: 1.1rem;
      line-height: 1.6;
      color: #444;
    }

    a.back-link {
      display: inline-block;
      margin-top: 2rem;
      text-decoration: none;
      color: #2e7d32;
      font-weight: bold;
    }

    a.back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <img src="<%= user.profileImage %>" alt="Profile Image">
    <a href="/logout">Logout</a>
  </div>

  <div class="container">
    <h1><%= blog.title %></h1>
    <img src="<%= blog.image %>" alt="Blog Image">
    <p><%= blog.description %></p>
    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
  </div>
</body>
</html>
